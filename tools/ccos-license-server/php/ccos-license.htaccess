# Defense in depth for the ccos-license/ state directory (vault.json, seed.hex,
# rate.txt). The directory belongs OUTSIDE the webroot — this file is the
# seatbelt for the day someone uploads it inside by mistake: copy it INTO
# ccos-license/ as `.htaccess` and every web request to the directory is
# refused, on both Apache 2.2 and 2.4 syntax.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
